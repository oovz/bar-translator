{
  "name": "bar-translator",
  "version": "1.2.2",
  "description": "Quick translations from the Chrome address bar",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test",
    "lint": "eslint .",
    "typecheck": "wxt prepare && tsc --noEmit"
  },
  "keywords": [
    "chrome-extension",
    "translation",
    "omnibox"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "preact": "11.0.1",
    "sortablejs": "^1.15.7",
    "wxt": "0.21.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "~1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/preact": "^3.2.4",
    "@testing-library/user-event": "^14.6.8",
    "@types/chrome": "^0.3.5",
    "@types/node": "^24.19.2",
    "@types/sortablejs": "^1.15.9",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "web-ext": "^10.8.0"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
